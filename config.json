{
  "logging": {
    "level": "INFO",
    "download_log_file": "weather-radar-download.log"
  },
  "download": {
    "max_trys": 7,
    "websocket_url": "ws://localhost:8765/update",
    "radar_api_url": "https://radar-api.protezionecivile.it/wide/product/downloadProduct",
    "base_url": "https://data.meteo.uniparthenope.it/instruments/rdr0",
    "base_path": "/storage/ccmmma/prometeo/data/instruments/rdr0",
    "products": [
      "VMI"
    ],
    "timezone": "Europe/Rome",
    "interval_minutes": 10,
    "retry_sleep_seconds": 60
  },
  "websocket_client": {
    "url": "ws://localhost:8765/subscribe",
    "product_type": "VMI"
  },
  "update_sender": {
    "websocket_url": "ws://localhost:8765/update",
    "product_type": "VMI",
    "file_path": "/storage/abc.tiff",
    "file_url": "http://abc.tiff"
  },
  "websocket_server": {
    "host": "0.0.0.0",
    "port": 8765,
    "max_size": 1048576,
    "ping_interval": 20,
    "ping_timeout": 20
  }
}
