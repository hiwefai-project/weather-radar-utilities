#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${VENV_DIR:-${SCRIPT_DIR}/venv}"
PYTHON_BIN="${PYTHON_BIN:-${VENV_DIR}/bin/python}"
LOG_FILE="${LOG_FILE:-${SCRIPT_DIR}/weather-radar-download.log}"
LOCK_FILE="${LOCK_FILE:-${SCRIPT_DIR}/weather-radar-download.lock}"
CONFIG_FILE="${CONFIG_FILE:-${SCRIPT_DIR}/config.json}"

if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "Missing config.json at ${CONFIG_FILE}" >&2
  exit 1
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "Python executable not found at ${PYTHON_BIN}. Ensure the virtualenv exists." >&2
  exit 1
fi

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  echo "Another download is already running; exiting." >&2
  exit 0
fi

cd "${SCRIPT_DIR}"
"${PYTHON_BIN}" "${SCRIPT_DIR}/weather-radar-download.py" >>"${LOG_FILE}" 2>&1
